{
  "name": "word-worm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A two-player word game played on the surface of a 7x7x6 cube.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:dict": "node tools/build-dict.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wordnet-db": "^3.1.14"
  }
}
